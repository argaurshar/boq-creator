{
  "_comment": [
    "One corpus, two engines. frontend/src/engine/providers.ts (what the static",
    "build actually routes users' keys with) and backend/app/ai/providers.py must",
    "produce these exact answers. The frontend asserts it in",
    "frontend/scripts/check-providers.mjs (npm run check:providers, run in CI) and",
    "the backend in backend/tests/test_providers.py. A change on one side that is",
    "not mirrored on the other fails its own job."
  ],
  "normalize": [
    { "in": "sk-ant-api03-abcdefgh", "out": "sk-ant-api03-abcdefgh" },
    { "in": "  sk-kie-abcdefgh12  ", "out": "sk-kie-abcdefgh12" },
    { "in": "sk-kie-abcdefgh12\n", "out": "sk-kie-abcdefgh12" },
    { "in": "Bearer sk-kie-abcdefgh12", "out": "sk-kie-abcdefgh12" },
    { "in": "bearer sk-kie-abcdefgh12", "out": "sk-kie-abcdefgh12" },
    { "in": "BEARER  sk-kie-abcdefgh12", "out": "sk-kie-abcdefgh12" },
    { "in": "Bearer\tsk-kie-abcdefgh12", "out": "sk-kie-abcdefgh12" },
    { "in": "\"sk-ant-abcdefgh12\"", "out": "sk-ant-abcdefgh12" },
    { "in": "'sk-kie-abcdefgh12'", "out": "sk-kie-abcdefgh12" },
    { "in": "\"Bearer sk-kie-abcdefgh12\"", "out": "sk-kie-abcdefgh12" },
    { "in": "export ANTHROPIC_API_KEY=\"Bearer sk-kie-abcdefgh12\"", "out": "sk-kie-abcdefgh12" },
    { "in": "export ANTHROPIC_AUTH_TOKEN=sk-kie-abcdefgh12", "out": "sk-kie-abcdefgh12" },
    { "in": "ANTHROPIC_API_KEY='sk-ant-api03-abcdefgh'", "out": "sk-ant-api03-abcdefgh" },
    { "in": "my key is sk-kie-abcdefgh12 thanks", "out": "sk-kie-abcdefgh12" },
    { "in": "\"", "out": "\"" },
    { "in": "''", "out": "" },
    { "in": "bearer", "out": "bearer" },
    { "in": "nonsense", "out": "nonsense" },
    { "in": "   ", "out": "" },
    { "in": "", "out": "" }
  ],
  "detect": [
    { "key": "sk-ant-api03-abcdefgh", "provider": "anthropic" },
    { "key": "SK-ANT-API03-ABCDEFGH", "provider": "anthropic" },
    { "key": "sk-kie-abcdefgh12", "provider": "kie" },
    { "key": "Bearer sk-kie-abcdefgh12", "provider": "kie" },
    { "key": "export ANTHROPIC_API_KEY=\"Bearer sk-kie-abcdefgh12\"", "provider": "kie" },
    { "key": "sk-other-abcdefgh12", "provider": null },
    { "key": "nonsense", "provider": null },
    { "key": "", "provider": null }
  ],
  "resolve": [
    { "key": "sk-ant-abcdefgh12", "pref": "auto", "provider": "anthropic" },
    { "key": "sk-kie-abcdefgh12", "pref": "auto", "provider": "kie" },
    { "key": "sk-kie-abcdefgh12", "pref": "anthropic", "provider": "kie", "ignored": true },
    { "key": "sk-ant-abcdefgh12", "pref": "kie", "provider": "anthropic", "ignored": true },
    { "key": "sk-kie-abcdefgh12", "pref": "kie", "provider": "kie", "ignored": false },
    { "key": "sk-other-abcdefgh12", "pref": "kie", "provider": "kie", "ignored": false },
    { "key": "sk-other-abcdefgh12", "pref": "auto", "provider": "anthropic", "ignored": false },
    { "key": "", "pref": "auto", "provider": "anthropic", "ignored": false },
    { "key": "", "pref": "kie", "provider": "kie", "ignored": false }
  ],
  "headers": [
    {
      "provider": "anthropic",
      "key": "sk-ant-abcdefgh12",
      "headers": {
        "content-type": "application/json",
        "anthropic-version": "2023-06-01",
        "x-api-key": "sk-ant-abcdefgh12",
        "anthropic-dangerous-direct-browser-access": "true"
      }
    },
    {
      "provider": "kie",
      "key": "Bearer sk-kie-abcdefgh12",
      "headers": {
        "content-type": "application/json",
        "anthropic-version": "2023-06-01",
        "authorization": "Bearer sk-kie-abcdefgh12"
      }
    }
  ],
  "endpoints": {
    "anthropic": "https://api.anthropic.com/v1/messages",
    "kie": "https://api.kie.ai/claude/v1/messages"
  },
  "models": [
    ["claude-sonnet-4-6", "Sonnet (fast)"],
    ["claude-opus-4-8", "Opus (most thorough)"]
  ]
}
