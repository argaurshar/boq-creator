# Copy to backend/.env (or export) to configure the backend.

# AI provider: "mock" (default, no key, key-free NL parsing) or "claude".
AI_PROVIDER=mock

# Required only when AI_PROVIDER=claude. Used server-side only.
# Accepts an Anthropic key (sk-ant-...) or a kie.ai key (sk-kie-...) — the
# prefix selects the endpoint automatically.
ANTHROPIC_API_KEY=

# Which host serves the Messages API for THIS server's key: auto (from the key
# prefix), anthropic, kie. A key a user brings from the browser always follows
# its own prefix and is never redirected by this setting.
AI_API_PROVIDER=auto

# Optional explicit API root for this server's key (no /v1/messages), e.g.
# https://api.kie.ai/claude
ANTHROPIC_BASE_URL=

# Claude model for vision extraction + NL parsing (Sonnet by default).
CLAUDE_MODEL=claude-sonnet-4-6

# Database (SQLite by default; point at Postgres in production).
BOQ_DB_URL=sqlite:///./boq.db

# Where uploaded PDFs are stored.
BOQ_UPLOAD_DIR=./uploads

# CORS (comma-separated). Default allows all for local dev.
BOQ_CORS_ORIGINS=*
